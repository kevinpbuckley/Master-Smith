# Required: your own keys. fal.ai makes the meshes, masks, rigs and the repaint; OpenRouter runs the director,
# the vision checks and the picture models.
FAL_KEY=
OPENROUTER_API_KEY=

# Headless Blender (5.2 expected). Default on Windows is the standard install path; the Docker image sets its own.
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# Where builds (out/), uploads and the SQLite ledger go. Default: the repository.
# MASTERSMITH_DATA=./data

# Model routing (OpenRouter ids)
# MASTERSMITH_DIRECTOR_MODEL=google/gemini-3.8-flash
# MASTERSMITH_VISION_MODEL=google/gemini-3.8-flash
# MASTERSMITH_CONCEPT_MODEL=google/gemini-3.1-flash-image
# MASTERSMITH_EDIT_MODEL=google/gemini-3.1-flash-image

# Shared instance: refuse builds a user's balance does not cover, and mark up the provider cost.
# MASTERSMITH_ENFORCE_CREDITS=0
# MASTERSMITH_MARKUP=1.0
